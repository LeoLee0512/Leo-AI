{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo-ai.local/schemas/pinn/adversarial-core-manifest-v1.3.json",
  "title": "Leo AI PINN adversarial expected-verdict manifest",
  "type": "object",
  "required": [
    "lockStatusAuthority",
    "manifestVersion",
    "suiteVersion",
    "schemaVersion",
    "conceptualCaseCount",
    "executableScenarioCount",
    "categories",
    "testModes",
    "expectedVerdictRegistration",
    "cases"
  ],
  "properties": {
    "lockStatusAuthority": {
      "const": "lock.json"
    },
    "manifestVersion": {
      "const": "1.0"
    },
    "suiteVersion": {
      "const": "PINN-CLOSED-LOOP-CORE-1.0"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "conceptualCaseCount": {
      "const": 15
    },
    "executableScenarioCount": {
      "const": 18
    },
    "categories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ANALYTIC",
          "STRUCTURAL",
          "PROVENANCE",
          "BITWISE_TRAINING"
        ]
      }
    },
    "testModes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "WORKFLOW_E2E",
          "VALIDATOR_COMPONENT",
          "TRAINING_E2E"
        ]
      }
    },
    "expectedVerdictRegistration": {
      "type": "object",
      "required": [
        "declaredBeforeFirstExecution",
        "resultIndependent",
        "lockBindingField"
      ],
      "properties": {
        "declaredBeforeFirstExecution": {
          "const": true
        },
        "resultIndependent": {
          "const": true
        },
        "lockBindingField": {
          "const": "adversarialManifestSha256"
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "conceptualIntent",
          "subcases"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "(G1|B([1-9]|10|11)|U[1-3])"
          },
          "conceptualIntent": {
            "type": "string",
            "minLength": 10
          },
          "subcases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/scenario"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "subcaseId",
        "testMode",
        "category",
        "construction",
        "trainingApplicable",
        "expected"
      ],
      "properties": {
        "subcaseId": {
          "type": "string",
          "pattern": "(G1|B([1-9]|10|11)[a-c]?|U[1-3])"
        },
        "testMode": {
          "enum": [
            "WORKFLOW_E2E",
            "VALIDATOR_COMPONENT",
            "TRAINING_E2E"
          ]
        },
        "category": {
          "enum": [
            "ANALYTIC",
            "STRUCTURAL",
            "PROVENANCE",
            "BITWISE_TRAINING"
          ]
        },
        "construction": {
          "type": "object",
          "required": [
            "description",
            "frozenParameters"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 10
            },
            "frozenParameters": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "trainingApplicable": {
          "type": "boolean"
        },
        "expected": {
          "type": "object",
          "required": [
            "gateStatus",
            "workflowStatus",
            "claimStatus",
            "failureRecord",
            "stopTheLine"
          ],
          "properties": {
            "gateStatus": {
              "type": "object",
              "properties": {
                "G1": {
                  "$ref": "#/$defs/gateStatus"
                },
                "G2": {
                  "$ref": "#/$defs/gateStatus"
                },
                "G3": {
                  "$ref": "#/$defs/gateStatus"
                },
                "G4": {
                  "$ref": "#/$defs/gateStatus"
                },
                "G5": {
                  "$ref": "#/$defs/gateStatus"
                },
                "G6": {
                  "$ref": "#/$defs/gateStatus"
                },
                "G7": {
                  "$ref": "#/$defs/gateStatus"
                }
              },
              "additionalProperties": false
            },
            "workflowStatus": {
              "enum": [
                "DRAFT",
                "SPEC_LOCKED",
                "BASELINE_VERIFIED",
                "IMPLEMENTATION_VERIFIED",
                "TRAINING_COMPLETED",
                "VALIDATION",
                "REPRODUCIBILITY_CHECK",
                "ACCEPTED",
                "FAILURE_RECORDED",
                "DIAGNOSED",
                "REVISED",
                "STOPPED_THE_LINE",
                "NOT_APPLICABLE"
              ]
            },
            "claimStatus": {
              "type": "object",
              "properties": {
                "C0": {
                  "$ref": "#/$defs/claimStatus"
                },
                "C1": {
                  "$ref": "#/$defs/claimStatus"
                },
                "C2": {
                  "$ref": "#/$defs/claimStatus"
                },
                "C3": {
                  "$ref": "#/$defs/claimStatus"
                }
              },
              "additionalProperties": false
            },
            "componentDecision": {
              "type": "string"
            },
            "failureRecord": {
              "type": "object",
              "required": [
                "required",
                "taxonomy",
                "requirements"
              ],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "taxonomy": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "SPEC",
                        "BASELINE",
                        "IMPLEMENTATION",
                        "SCALING",
                        "SAMPLING",
                        "OPTIMIZATION",
                        "LOSS_BALANCE",
                        "MODEL_CAPACITY",
                        "NUMERICAL",
                        "VALIDATION",
                        "INFRASTRUCTURE",
                        "PROVENANCE",
                        "UNKNOWN"
                      ]
                    }
                  ]
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "stopTheLine": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "PARTIAL"
      ]
    },
    "claimStatus": {
      "enum": [
        "SUPPORTED",
        "NOT_SUPPORTED",
        "REFUTED",
        "BLOCKED",
        "WITHDRAWN",
        "NOT_APPLICABLE"
      ]
    }
  }
}
