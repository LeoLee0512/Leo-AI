# Build environment — recreated from the dependency lock, never committed.
.venv/

# Build outputs. `dist/` is generated by tools/build_launcher.ps1 and
# `pyi-work/` is PyInstaller scratch; neither is a source of truth.
dist/
pyi-work/

# Python bytecode and test caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Build inputs record written next to a build's output.
build-inputs.json

# Release manifests are generated per build; the schema is committed, the
# instances are not.
manifests/build-*.json

# PyInstaller generates this on every build (build_launcher.ps1 --specpath), and
# the generated file bakes in absolute paths from the build machine. It is an
# output, not a source.
pyi-spec/*.spec

# Vendored wheels. Generated by tools/build_wheelhouse.py from requirements.lock;
# large binaries do not belong in git history. What is committed is
# manifests/wheelhouse.json, which names every wheel with its tags and SHA-256 --
# enough to verify a wheelhouse someone else built, and enough to notice if one
# was tampered with. Regenerate with:  python tools/build_wheelhouse.py build
wheelhouse/
wheelhouse-science/

# Manual-acceptance evidence. Collected per machine outside the source tree,
# and by design it records where it was collected: hostnames, the operator's
# home directory, the local install paths. That is what makes it evidence, and
# exactly what must not enter a repository that has to build on someone else's
# computer. A person attaches these files to the checklist item they ran; they
# are not repository sources.
docs/manual-acceptance-evidence/

# An app root or the separate Leo Tree project may sit inside a checkout. `LeoAIStudio/` is the
# default AppRoot of the build, deploy and verify tools (override with LEO_APP_ROOT or -AppRoot):
# launcher EXE, WebView2 runtime, the pinned upstream OpenAI4S checkout and, under `user/`,
# DPAPI credentials and session state -- none of which is source. `leotree/` is a separate
# project with its own git repository. Neither is ever committed here.
LeoAIStudio/
leotree/

# Claude Code worktrees are checked out under the repository folder; git
# already tracks them as worktrees, so their contents must not be added
# as files of this checkout.
.claude/worktrees/
